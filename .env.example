# NOTE: avoid using quotes (single ' or double ") for environment varibles values
# as well as using escaped characters (e.g. newline '\n').
ENV_FOR_DYNACONF=development

# Define storage base path
HAMCONTESTANALYSISSTORAGE=

# Define plots storage base path
HAMCONTESTANALYSISPLOTS=

# Profiler (debug purposes)
PROFILER_DIR=

# Overrides to application settings via environment variables.
# - settings.storage.prefix_plots can be overriden by defining the variable
# HCA_STORAGE__PREFIX_PLOTS=
# - settings.storage.paths.raw_data can be overriden by defining the variable
# HCA_STORAGE_PATHS__RAW_DATA=
